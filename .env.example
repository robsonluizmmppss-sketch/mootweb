# ------------------------------------------------------------------
# MootWeb — variáveis de ambiente
# Copie para .env e ajuste os valores.
# ------------------------------------------------------------------

# App
# Local: http://localhost:3000 · Produção: https://mootweb.online
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Banco de dados (local sem Docker: `npm run db:up`)
DATABASE_URL="postgresql://mootweb:mootweb@localhost:5432/mootweb?schema=public"
# Conexão direta (migrations). Local = igual ao DATABASE_URL.
DIRECT_URL="postgresql://mootweb:mootweb@localhost:5432/mootweb?schema=public"

# NextAuth / Auth.js
# Gere um segredo: `openssl rand -base64 32`
AUTH_SECRET="troque-por-um-segredo-forte"
# Local: http://localhost:3000 · Produção: https://mootweb.online
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# E-mail (recuperação de senha / notificações) — Fase 2
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="MootWeb <no-reply@mootweb.online>"

# Uploads — Fase 3 (S3 compatível opcional; padrão = disco local)
STORAGE_DRIVER="local" # local | s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Analytics / Pixels (também editáveis pelo painel; env serve de fallback)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""

# Rate limit (Fase 2)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="60"
