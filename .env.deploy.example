# ============================================================================
#  Deploy — Vercel + Supabase   (copie para .env.deploy e preencha)
#  .env.deploy é gitignored. Depois: `npm run deploy`
# ============================================================================

# --- Supabase (Dashboard → Project → Settings → Database → Connection string) ---
# "Transaction" (pooler, porta 6543) — usado pelo app em produção:
SUPABASE_DB_URL_POOLED="postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# "Session" / direta (porta 5432) — usado para migrations e seed:
SUPABASE_DB_URL_DIRECT="postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- App ---
PROD_SITE_URL="https://mootweb.online"   # ou deixe vazio p/ usar o domínio .vercel.app
PROD_AUTH_SECRET=""                       # opcional; gerado automaticamente se vazio

# --- Opcionais (e-mail transacional / analytics) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="MootWeb <no-reply@mootweb.online>"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
